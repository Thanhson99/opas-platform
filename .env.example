# Normal app database. Keep this data when rebuilding Docker.
POSTGRES_DB=laravel
POSTGRES_USER=root
POSTGRES_PASSWORD=change-me
POSTGRES_DATA_PATH=./docker/postgres/data

# PHPUnit database. Tests can refresh this database without touching the app database.
POSTGRES_TEST_DB=laravel_testing
POSTGRES_TEST_USER=root
POSTGRES_TEST_PASSWORD=change-me
POSTGRES_TEST_DATA_PATH=./docker/postgres-testing/data

LARAVEL_DB_HOST=postgres
LARAVEL_DB_PORT=5432
LARAVEL_DB_DATABASE=laravel
LARAVEL_DB_USERNAME=root
LARAVEL_DB_PASSWORD=change-me

SHARED_NET_NAME=shared_net
