ENV=dev
LOG_LEVEL=INFO

# Douyin downloader backend: playwright or selenium
TOOL_DOUYIN_BACKEND=playwright
PW_HEADLESS=false
PW_MOBILE_UA=true

# Optional upstream proxy for China-restricted hosts
CHINA_PROXY_URL=
CHINA_PROXY_TIMEOUT=30
CHINA_PROXY_VERIFY_SSL=true
CHINA_PROXY_ALLOWED_HOSTS=douyin.com,www.douyin.com,v.douyin.com,iesdouyin.com,www.iesdouyin.com
