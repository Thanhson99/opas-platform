    {
      "parameters": {
        "content": "## 🔧 CONFIGURATION – Workflow Settings\nThis section defines all workflow configuration variables:\n• folderPath: the local folder containing input videos\n• uploadedFolderPath: the folder where uploaded videos will be moved\n• Optional metadata such as privacy, title prefix, etc.\nUsed as the global setup for the entire workflow.\n\n",
        "height": 576,
        "width": 608,
        "color": 5
