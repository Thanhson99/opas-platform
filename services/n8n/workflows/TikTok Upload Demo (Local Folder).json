    {
      "parameters": {
        "command": "=ls -1 \"{{ $json.folderPath }}\""
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -336,
        112
      ],
      "id": "d5290dcb-0885-4597-919f-f283ecc17f87",
      "name": "List Files"
    },
    {
      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout || '';\nconst stderr = $input.first().json.stderr || '';\nconst folderPath = $('Config').first().json.folderPath;\n\nif (stderr && stderr.trim().length > 0) {\n  throw new Error('Đường dẫn thư mục KHÔNG tồn tại hoặc không đọc được: ' + folderPath);\n}\n\n// tách dòng\nconst lines = stdout\n  .split('\\n')\n  .map(l => l.trim())\n  .filter(l => l.length > 0);\n\n// đuôi video\nconst videoExts = ['.mp4', '.mov', '.mkv', '.avi', '.webm', '.m4v'];\n\nconst items = [];\n\nfor (const name of lines) {\n  const lower = name.toLowerCase();\n  const isVideo = videoExts.some(ext => lower.endsWith(ext));\n  if (!isVideo) continue;\n\n  const fullPath = folderPath.endsWith('/')\n    ? folderPath + name\n    : folderPath + '/' + name;\n\n  items.push({\n    json: {\n      fileName: name,\n      filePath: fullPath\n    }\n  });\n}\n\nif (items.length === 0) {\n  return [{\n    json: {\n      status: 'NO_VIDEOS',\n      folderPath\n    }\n  }];\n}\n\nreturn items;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        112
      ],
      "id": "45694d71-7c43-4f82-b146-6ac24af9cd81",
      "name": "Check & Parse Files"
    },
