    },
    {
      "parameters": {
        "jsCode": "// Get data from input\nconst from = $input.all()[1].json.body.from;\nconst amount = $input.all()[1].json.body.amount;\nconst to = $input.all()[1].json.body.to;\nconst rates = $input.first().json.conversion_rates;\n\nif (!rates[to]) {\n  throw new Error(`Unsupported target currency: ${to}`);\n}\n\n// Calculate converted amount\nconst converted = amount * rates[to];\n\nreturn [{\n  from: from,\n  to,\n  amount,\n  converted,\n  rate: rates[to]\n}];\n"
      },
