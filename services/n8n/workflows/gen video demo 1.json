    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst operationData = $('📋 Parse Response').item.json;\n\nconsole.log('Status Response:', JSON.stringify(response, null, 2));\n\nif (response.error) {\n  throw new Error(`❌ Status Error: ${response.error.message}`);\n}\n\nif (response.done === true) {\n  if (response.response && response.response.generateVideoResponse) {\n    const videoData = response.response.generateVideoResponse.generatedSamples[0];\n    \n    if (videoData && videoData.video && videoData.video.uri) {\n      const startTime = new Date(operationData.start_time);\n      const endTime = new Date();\n      const duration = ((endTime - startTime) / 1000).toFixed(2);\n      \n      return {\n        status: 'completed',\n        video_uri: videoData.video.uri,\n        operation_name: response.name,\n        completed_at: new Date().toISOString(),\n        generation_duration: duration + ' seconds',\n        message: '🎉 Video generation completed successfully!',\n        ready_to_download: true\n      };\n    } else {\n      throw new Error('❌ Video completed but no download URI found');\n    }\n  } else {\n    throw new Error('❌ Operation completed but no video response');\n  }\n} else {\n  return {\n    status: 'processing',\n    operation_name: response.name,\n    message: '🔄 Video still processing... Continue polling',\n    need_retry: true,\n    poll_url: operationData.poll_url,\n    elapsed_time: ((new Date() - new Date(operationData.start_time)) / 1000).toFixed(0) + 's'\n  };\n}"
      },
