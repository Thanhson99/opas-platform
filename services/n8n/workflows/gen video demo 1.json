      "id": "36c47d46-7765-464f-b002-c250c81c275e",
      "name": "Calculate Total Video Duration"
    },
    {
      "parameters": {
        "jsCode": "let videoCount = 0;\nlet audioDuration = 0;\nlet totalVideoDuration = 0;\n\ntry {\n  const countVideosData = $('Count Videos').first();\n  if (countVideosData && countVideosData.json && countVideosData.json.stdout) {\n    videoCount = parseInt(countVideosData.json.stdout.trim());\n  }\n} catch (error) {\n  console.log('Count Videos node not executed or no data');\n}\n\ntry {\n  const audioDurationData = $('Get Audio Duration').first();\n  if (audioDurationData && audioDurationData.json && audioDurationData.json.stdout) {\n    audioDuration = parseFloat(audioDurationData.json.stdout.trim());\n  }\n} catch (error) {\n  console.log('Get Audio Duration node not executed or no data');\n}\n\ntry {\n  const totalVideoData = $('Calculate Total Video Duration').first();\n  if (totalVideoData && totalVideoData.json && totalVideoData.json.stdout) {\n    totalVideoDuration = parseFloat(totalVideoData.json.stdout.trim());\n  }\n} catch (error) {\n  console.log('Calculate Total Video Duration node not executed or no data');\n}\n\nconsole.log(`Video count: ${videoCount}`);\nconsole.log(`Audio duration: ${audioDuration}s`);\nconsole.log(`Total video duration: ${totalVideoDuration}s`);\n\nlet loopCount = 1;\nlet finalVideoDuration = totalVideoDuration;\n\n// Nếu video không đủ thời gian, tính số lần cần lặp lại\nif (totalVideoDuration > 0 && totalVideoDuration < audioDuration) {\n  loopCount = Math.ceil(audioDuration / totalVideoDuration);\n  finalVideoDuration = totalVideoDuration * loopCount;\n  console.log(`Need to loop videos ${loopCount} times to reach ${audioDuration}s`);\n}\n\n// Tạo command để merge videos, loại bỏ 2 video đầu tiên\nlet mergeCommand;\nif (loopCount === 1) {\n  // Không cần lặp, chỉ concatenate bình thường (bắt đầu từ video thứ 3)\n  mergeCommand = `ls -1 /tmp/n8n/videos/*.mp4 | sort -V | tail -n +3 | sed \"s|^|file '|; s|$|'|\" > /tmp/n8n/video_list.txt && ffmpeg -y -f concat -safe 0 -i /tmp/n8n/video_list.txt -c copy /tmp/n8n/videos_merged.mp4`;\n} else {\n  // Cần lặp lại videos nhiều lần (bắt đầu từ video thứ 3)\n  mergeCommand = `ls -1 /tmp/n8n/videos/*.mp4 | sort -V | tail -n +3 > /tmp/n8n/video_files.txt && `;\n  \n  // Tạo file list với videos được lặp lại\n  mergeCommand += `(`;\n  for (let i = 0; i < loopCount; i++) {\n    mergeCommand += `cat /tmp/n8n/video_files.txt | sed \"s|^|file '|; s|$|'|\"; `;\n  }\n  mergeCommand += `) > /tmp/n8n/video_list_looped.txt && `;\n  \n  // Merge tất cả\n  mergeCommand += `ffmpeg -y -f concat -safe 0 -i /tmp/n8n/video_list_looped.txt -c copy /tmp/n8n/videos_merged.mp4`;\n}\n\nreturn [{ \n  json: { \n    videoCount, \n    audioDuration, \n    totalVideoDuration, \n    loopCount, \n    finalVideoDuration,\n    needsLooping: totalVideoDuration < audioDuration,\n    command: mergeCommand\n  } \n}];\n"
      },
