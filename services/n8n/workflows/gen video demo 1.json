    {
      "parameters": {
        "command": "=total=0; for video in /tmp/n8n/videos/*.mp4; do if [ -f \"$video\" ]; then duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 \"$video\" 2>/dev/null || echo \"0\"); total=$(echo \"$total + $duration\" | bc); fi; done; echo $total"
