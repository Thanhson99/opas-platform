    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data;\n\nfunction extractDiv(html, id) {\n  const startIndex = html.indexOf(`<div id=\"${id}\"`);\n  if (startIndex === -1) return null;\n\n  let openDivs = 0;\n  let i = startIndex;\n\n  while (i < html.length) {\n    const nextOpen = html.indexOf('<div', i);\n    const nextClose = html.indexOf('</div>', i);\n\n    if (nextOpen !== -1 && nextOpen < nextClose) {\n      openDivs++;\n      i = nextOpen + 4;\n    } else if (nextClose !== -1) {\n      openDivs--;\n      i = nextClose + 6;\n      if (openDivs <= 0) {\n        return html.slice(startIndex, i);\n      }\n    } else {\n      break;\n    }\n  }\n  return null;\n}\n\nfunction stripHtmlTags(html) {\n  html = html.replace(/<script[\\s\\S]*?<\\/script>/gi, '');\n  html = html.replace(/<style[\\s\\S]*?<\\/style>/gi, '');\n  return html.replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim();\n}\n\nfunction getFirstParagraphs(html, count = 3) {\n  const paragraphs = [...html.matchAll(/<p[^>]*>([\\s\\S]*?)<\\/p>/gi)].map(match => match[1]);\n  return paragraphs.slice(0, count).map(p => stripHtmlTags(p));\n}\n\nconst rawContent = extractDiv(html, 'article-content');\nconst plainText = rawContent ? stripHtmlTags(rawContent) : '';\nconst firstParagraphs = rawContent ? getFirstParagraphs(rawContent, 3) : [];\n\nconst combinedContent = firstParagraphs.join(' ');\nconst cleanedContent = combinedContent.replace(/[\"\\n\\r]/g, \" \").trim();\n\nreturn [{\n  json: {\n    rawContent: rawContent,\n    plainText: plainText,\n    cleanedContent: cleanedContent,\n    paragraphs: firstParagraphs,\n    wordCount: cleanedContent.split(' ').length\n  }\n}];"
      },
