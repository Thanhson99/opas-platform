    {
      "parameters": {
        "jsCode": "const httpData = $input.first().json.data.list;\nconst timeNow = new Date().toLocaleString('vi-VN', {\n    timeZone: 'Asia/Ho_Chi_Minh',\n    hour12: false\n});\n\nif (httpData && httpData.length > 0) {\n    const first = httpData[0];\n    const jumpUrl = first.jump_url;\n    const idMatch = jumpUrl.match(/id=(\\d+)/);\n    const id = idMatch ? idMatch[1] : null;\n\n    return [{\n        json: {\n            title: first.translated_title || first.title,\n            id: id,\n            timeNow: timeNow,\n            originalContent: first.content || ''\n        }\n    }];\n} else {\n    return [{\n        json: {\n            error: 'No trending news found',\n            title: 'Market Update',\n            id: null,\n            timeNow: timeNow\n        }\n    }];\n}"
      },
