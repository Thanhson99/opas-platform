      ],
      "id": "bbb4c746-6dd3-4dcb-9498-a6fd65af8e4d",
      "name": "Sticky Note3"
    },
    {
      "parameters": {
        "content": "## 📤 YOUTUBE UPLOAD – Publish Video via API\n\nUploads the binary video to YouTube using OAuth2 credentials.\nIncludes metadata:\n• Title\n• Description\n• Category\n• Privacy status\nReturns the YouTube videoId or uploadId.",
        "height": 544,
        "width": 384,
        "color": 3
