    {
      "parameters": {
        "jsCode": "// Lấy toàn bộ input (XML node output)\nconst allInput = $input.all();\nconst data = allInput[0]?.json;\n\n// Lấy danh sách bài viết trong feed\nconst itemsRaw = data?.rss?.channel?.item || [];\n\n// Lấy 1 bài đầu tiên (thường là mới nhất)\nconst i = itemsRaw[0];\nif (!i) {\n  return [];\n}\n\n// Lấy ảnh từ <media:content>\nconst media = i[\"media:content\"];\nconst image = media?.url || \"\";\n\n// Category array -> string\nconst category = Array.isArray(i.category)\n  ? i.category.join(\", \")\n  : \"\";\n\nreturn [\n  {\n    json: {\n      title: i.title || \"\",\n      link: i.link || \"\",\n      pubDate: i.pubDate || \"\",\n      description: i.description || \"\",\n      creator: i[\"dc:creator\"] || \"\",\n      category,\n      image,\n      source: \"coingape\"\n    }\n  }\n];\n"
      },
