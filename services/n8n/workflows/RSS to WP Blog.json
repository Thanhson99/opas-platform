    {
      "parameters": {
        "jsCode": "const allInput = $input.all();\nconst data = allInput[0]?.json;\n\n// Lấy danh sách bài viết\nconst itemsRaw = data?.rss?.channel?.item || [];\nif (!itemsRaw.length) return [];\n\n// Bài mới nhất ( bài đầu tiên )\nconst i = itemsRaw[0];\n\n// Lấy ảnh từ description: <img src=\"...\">\nlet image = \"\";\nif (typeof i.description === \"string\") {\n  const match = i.description.match(/<img[^>]+src=\"([^\"]+)\"/i);\n  if (match && match[1]) image = match[1];\n}\n\n// Nếu không có trong description thì xem thử content:encoded\nif (!image && typeof i[\"content:encoded\"] === \"string\") {\n  const match = i[\"content:encoded\"].match(/<img[^>]+src=\"([^\"]+)\"/i);\n  if (match && match[1]) image = match[1];\n}\n\n// Category array -> string\nconst category = Array.isArray(i.category)\n  ? i.category.join(\", \")\n  : (i.category || \"\");\n\n// Build item chuẩn hóa\nreturn [\n  {\n    json: {\n      title: i.title || \"\",\n      link: i.link || \"\",\n      pubDate: i.pubDate || \"\",\n      description: i.description || \"\",\n      creator: i[\"dc:creator\"] || \"\",\n      category,\n      image,\n      source: \"bitcoinmagazine\"\n    }\n  }\n];\n"
      },
