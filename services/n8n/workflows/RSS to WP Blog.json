      "id": "8e5035fc-0c55-4997-b2b2-cb3948e32e5c",
      "name": "Merge – Primary RSS Feeds"
    },
    {
      "parameters": {
        "jsCode": "// Cấu hình\nconst MAX_AGE_MINUTES = 10; // chỉ lấy bài trong vòng 10 phút gần nhất\n\nconst now = new Date();\nconst maxAgeMs = MAX_AGE_MINUTES * 60 * 1000;\n\nfunction stripHtml(html) {\n  if (!html) return \"\";\n  return html.replace(/<[^>]*>/g, \"\").replace(/\\s+/g, \" \").trim();\n}\n\nconst items = $input.all().map(i => i.json);\nconst out = [];\n\nfor (const it of items) {\n  // 1) Xác định source\n  let source = it.source;\n  if (!source && typeof it.link === \"string\") {\n    if (it.link.includes(\"coindesk.com\")) source = \"coindesk\";\n    else if (it.link.includes(\"bitcoinmagazine.com\")) source = \"bitcoinmagazine\";\n    else if (it.link.includes(\"coingape.com\")) source = \"coingape\";\n    else source = \"unknown\";\n  }\n\n  // 2) Lấy pubDate (nhớ ưu tiên isoDate nếu có)\n  const pubRaw = it.isoDate || it.pubDate || \"\";\n  const pubDate = new Date(pubRaw);\n  if (isNaN(pubDate)) {\n    // Không parse được ngày -> bỏ\n    continue;\n  }\n\n  const ageMs = now - pubDate;\n  // Nếu bài quá cũ so với config -> bỏ\n  if (ageMs > maxAgeMs) {\n    continue;\n  }\n  // Nếu lỡ RSS trả future date (clock lệch) > 5 phút -> cũng skip\n  if (pubDate - now > 5 * 60 * 1000) {\n    continue;\n  }\n\n  // 3) Chuẩn hoá summary cho gọn, bớt HTML & bớt dài\n  const rawSummary =\n    it.contentSnippet ||\n    stripHtml(it.description || it.content || \"\") ||\n    \"\";\n\n  const summary = rawSummary.slice(0, 400); // cắt ngắn cho nhẹ\n\n  // 4) Tạo UID ổn định để dedupe nhiều lần chạy\n  const guidRaw =\n    (it.guid && it.guid._) ||\n    it.guid ||\n    it.link ||\n    it.title;\n\n  if (!guidRaw) continue;\n\n  const uid = `${source}|${guidRaw}`;\n\n  // 5) Push item đã chuẩn hoá ra ngoài\n  out.push({\n    json: {\n      uid,\n      title: it.title || \"\",\n      link: it.link || \"\",\n      pubDate: pubDate.toISOString(),\n      source,\n      summary,\n      image: it.image || undefined, // nếu có\n    }\n  });\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -1104
      ],
