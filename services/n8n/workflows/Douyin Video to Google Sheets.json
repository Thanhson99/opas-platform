    },
    {
      "parameters": {
        "jsCode": "/**\n * Format Douyin video data for Google Sheets\n */\nconst videos = items[0].json.aweme_list || [];\nreturn videos.slice(0, $json[\"limit\"]).map(v => {\n  return {\n    json: {\n      title: v.desc,\n      video_url: v.video.play_addr.url_list[0],\n      download_url: v.video.download_addr.url_list[0],\n      created_time: new Date().toISOString()\n    }\n  }\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        -96
      ],
      "id": "d64761e4-d4c8-4de6-97aa-566cc0358379",
      "name": "Format Video Data"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://snaptik.app/action.php",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "=application/x-www-form-urlencoded"
            },
            {
              "name": "url",
              "value": "={{$json[\"video_url\"]}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        -96
      ],
      "id": "6938a91f-2d7c-476a-b6ff-95ae2226c6b0",
      "name": "Download from SnapTik"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  return {\n    json: {\n      original_link: item.json.url,\n      download_link: item.json.download_link,\n      created_time: new Date().toISOString()\n    }\n  }\n});\n"
      },
