      ],
      "id": "8df4ff50-fc47-4d04-9e8c-e435aa24f282",
      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "content": "## 🎞️ PARSE & FILTER VIDEO FILES\nThis section:\n• Detects missing or invalid folder paths\n• Splits the raw file list\n• Filters by video extensions (.mp4, .mov, .mkv, .avi, ...)\n• Generates: fileName + filePath\n• Handles the \"NO VIDEOS\" scenario\n",
        "height": 432,
        "width": 1168
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -160,
        -176
      ],
      "id": "f585d5aa-59a0-4635-80f4-d239a45aa18a",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "content": "## 📥 READ VIDEO FILE – Load Binary Data\nReads the selected video file from disk and loads it as binary\n(binary property: \"data\").\nThis binary payload is then passed to the YouTube Upload node.\n",
        "height": 384,
