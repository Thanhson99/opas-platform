      ],
      "id": "db73cb82-e40b-4e56-bf7a-83bec2a2ec9f",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "content": "## 📂 SCAN SOURCE FOLDER – List Files in Directory\nThis section scans the video folder using a Linux command (ls).\nThe node returns:\n• stdout → file list\n• stderr → error if folder not found\nThis prepares the raw list of files for further filtering.\n",
        "height": 576,
        "width": 256,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -416,
