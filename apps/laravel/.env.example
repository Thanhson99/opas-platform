########################################
# Core Application
########################################

# Application
# Basic Laravel identity and public URL for local browser/API access.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8881

# Localization
# Default backend locale and faker locale used by tests/seeders.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance
# Keep local maintenance mode file-based unless the app must coordinate across machines.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP Runtime
# Number of workers used by Laravel's built-in PHP server.
PHP_CLI_SERVER_WORKERS=4

# Security
# Password hashing work factor.
BCRYPT_ROUNDS=12

########################################
# Platform Runtime
########################################

# Logging
# Local default writes application logs to storage/logs.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
# PostgreSQL connection used by Docker Compose.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=change-me

# Session
# Session data is persisted in the database for local multi-process stability.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue and Filesystem
# Database queue is used by auto-coding workers and local background jobs.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE=default

# Cache
# Database cache avoids requiring Redis for the default local stack.
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached
# Only used if CACHE_STORE is switched to memcached.
MEMCACHED_HOST=127.0.0.1

# Redis
# Optional Redis settings for queue/cache/session drivers when enabled.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default

########################################
# Communication
########################################

# Mail
# Local-safe default: write emails to laravel.log.
# To send real email, switch MAIL_MAILER to smtp and fill the SMTP values below.
MAIL_MAILER=log
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_EHLO_DOMAIN=localhost
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

########################################
# Authentication
########################################

# Auth
# Shared auth/provider policy settings.
AUTH_PROVIDER_KEY_PATTERN=^[a-z][a-z0-9_-]{1,63}$
AUTH_PROVIDER_KEY_EXAMPLE=google
AUTH_EMAIL_PROVIDER_DEFAULT_VERIFICATION_MODE=required
AUTH_EMAIL_VERIFICATION_EXPIRE_MINUTES=60
AUTH_EMAIL_VERIFICATION_CODE_LENGTH=6
AUTH_OAUTH_HTTP_TIMEOUT_SECONDS=15

# Auth: Google OAuth
AUTH_GOOGLE_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
AUTH_GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
AUTH_GOOGLE_USER_INFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo

# Auth: Facebook OAuth
AUTH_FACEBOOK_AUTHORIZATION_ENDPOINT=https://www.facebook.com/v23.0/dialog/oauth
AUTH_FACEBOOK_TOKEN_ENDPOINT=https://graph.facebook.com/v23.0/oauth/access_token
AUTH_FACEBOOK_USER_INFO_ENDPOINT="https://graph.facebook.com/me?fields=id,name,email"

# Auth: GitHub OAuth
AUTH_GITHUB_AUTHORIZATION_ENDPOINT=https://github.com/login/oauth/authorize
AUTH_GITHUB_TOKEN_ENDPOINT=https://github.com/login/oauth/access_token
AUTH_GITHUB_USER_INFO_ENDPOINT=https://api.github.com/user
AUTH_GITHUB_USER_EMAILS_ENDPOINT=https://api.github.com/user/emails

########################################
# Integrations
########################################

# AWS
# Optional S3-compatible storage settings.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend
# App name exposed to Vite.
VITE_APP_NAME="${APP_NAME}"

# External APIs: Binance
# Base URL for Binance API (used to fetch coin market data)
BINANCE_BASE_URL=https://api.binance.com

# External APIs: CoinGecko
# Base URL for CoinGecko API
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# External APIs: Python Services
# Base URL for Python API (used for various Python-related tasks)
PYTHON_BASE_URL=https://python-services.sonvi.vn
PYTHON_DOUYIN_PATH=/douyin
PYTHON_CAPTION_PATH=/caption
PYTHON_TRENDING_PATH=/trending

########################################
# Auto Coding
########################################

# Auto Coding: Machine identity
# Identifies the connected workstation that receives local coding tasks.
AUTO_CODING_DEFAULT_REPOSITORY_PATH=/path/to/repository
AUTO_CODING_CONTAINER_REPOSITORY_PATH=/workspace/repo
AUTO_CODING_PROMPT_PATH=/path/to/repository/ai-local/agents/laravel-n8n-orchestrator.md
AUTO_CODING_MACHINE_KEY=
AUTO_CODING_MACHINE_STALE_SECONDS=300

# Auto Coding: Local Codex worker bridge
# Used when the web app runs in Docker/server but Codex CLI runs on the host machine.
AUTO_CODING_HOST_DB_HOST=127.0.0.1
AUTO_CODING_HOST_DB_PORT=5432
AUTO_CODING_LOCAL_WORKER_REPOSITORY_PATH=/path/to/repository
AUTO_CODING_LOCAL_WORKER_PROMPT_PATH=/path/to/repository/ai-local/agents/laravel-n8n-orchestrator.md
AUTO_CODING_LOCAL_WORKER_CAPABILITIES=codex,php,composer,node
AUTO_CODING_LOCAL_WORKER_WORKSPACE_BINDINGS=
AUTO_CODING_LOCAL_WORKER_MAX_PARALLEL_TASKS=1

# Auto Coding: GitHub defaults
# Base branch used when reports need branch/compare context.
AUTO_CODING_GITHUB_BASE_BRANCH=main

# Auto Coding: Provider selection
# Use "codex" for Codex CLI execution, "ollama" for local Ollama, or "null" for dry/no-op provider.
AUTO_CODING_PROVIDER=codex

# Auto Coding: Ollama provider
# Kept available as an alternate local provider.
AUTO_CODING_OLLAMA_BASE_URL=http://127.0.0.1:11434
AUTO_CODING_OLLAMA_MODEL=qwen2.5:7b
AUTO_CODING_OLLAMA_TIMEOUT_SECONDS=30

# Auto Coding: Codex CLI provider
# Runs Telegram/queued coding tasks through `codex exec` on this connected machine.
AUTO_CODING_CODEX_EXECUTABLE=codex
AUTO_CODING_CODEX_MODEL=
AUTO_CODING_CODEX_APPROVAL_MODE=auto-edit
AUTO_CODING_CODEX_SANDBOX=workspace-write
AUTO_CODING_CODEX_TIMEOUT_SECONDS=900
AUTO_CODING_CODEX_EXEC_ARGS="--color never --skip-git-repo-check"

# Auto Coding: Validation pipeline
# Commands run after coding work when validation is requested.
AUTO_CODING_VALIDATE_LINT="cd apps/laravel && ./vendor/bin/pint --test app"
AUTO_CODING_VALIDATE_STATIC_ANALYSIS="cd apps/laravel && ./vendor/bin/phpstan analyse --memory-limit=-1 --no-progress --configuration=phpstan.neon app"
AUTO_CODING_VALIDATE_TESTS="docker compose exec -T -w /var/www laravel php artisan test"
AUTO_CODING_VALIDATE_FRONTEND="cd apps/laravel && npm run check"

# Auto Coding: Workflow retry policy
# Controls automatic retry after failed validation groups.
AUTO_CODING_WORKFLOW_VALIDATION_RETRY_LIMIT=1
AUTO_CODING_WORKFLOW_RETRYABLE_VALIDATION_GROUPS=lint,static_analysis,tests,frontend

# Auto Coding: Telegram bot runtime
# Bot token, webhook secret, allowed chats/users/actions, locale, and limits are managed in the database.
AUTO_CODING_TELEGRAM_DEFAULT_KEY=default
AUTO_CODING_TELEGRAM_DEFAULT_DISPLAY_NAME="OPAS Telegram Remote Control"
AUTO_CODING_TELEGRAM_DEFAULT_PURPOSE=remote_control
AUTO_CODING_TELEGRAM_DEFAULT_ENVIRONMENT=local
AUTO_CODING_TELEGRAM_DEFAULT_MACHINE_GROUP=
AUTO_CODING_TELEGRAM_DEFAULT_LOCALE=en
AUTO_CODING_TELEGRAM_DEFAULT_API_BASE_URL=https://api.telegram.org
AUTO_CODING_TELEGRAM_DEFAULT_ALLOWED_UPDATES=message,callback_query
AUTO_CODING_TELEGRAM_DEFAULT_CHAT_HISTORY_LIMIT=30
AUTO_CODING_TELEGRAM_DEFAULT_CHAT_SESSION_TIMELINE_LIMIT=6
AUTO_CODING_TELEGRAM_PENDING_INTERACTION_TTL_MINUTES=30
AUTO_CODING_TELEGRAM_BOT_TOKEN=1234567890:example-token
AUTO_CODING_TELEGRAM_WEBHOOK_SECRET=example-webhook-secret
AUTO_CODING_TELEGRAM_ALLOWED_CHAT_IDS=123456789
AUTO_CODING_TELEGRAM_ALLOWED_USER_IDS=123456789
AUTO_CODING_TELEGRAM_ALLOWED_ACTIONS=help,menu,conversation,clarify_intent,clarify_issue_context,confirm_pending,chat_start,chat_ping,chat_status,chat_stop,chat_reset,create_task,queue,changes,summary,status,cancel_task,cancel_tasks,delete_task,delete_tasks,reset,resume
